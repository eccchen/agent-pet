NODE_ENV=development
PORT=3001
SERVICE_NAME=agent-game-server
STATE_PATH=.data/server-state.json
REQUEST_LOGGING=true
AUTH_MODE=unsafe
CHALLENGE_PREFIX=Sign this wallet challenge
CHAIN_SYNC_MODE=local
X_INTEGRATION_MODE=disabled
SYSTEM_AGENTS_ENABLED=false
SYSTEM_AGENT_TICK_INTERVAL_MS=30000
