# AUTH_MODE=eip191
# CHAIN_SYNC_MODE=xlayer
# X_INTEGRATION_MODE=local_upload
# DEPLOYMENT_MANIFEST_PATH=../../contracts/deployments/xlayer-testnet.json
# XLAYER_RPC_URL=https://xlayertestrpc.okx.com/terigon
XLAYER_CHAIN_ID=
XLAYER_RPC_URL=
PET_REGISTRY_ADDRESS=
BUDGET_VAULT_ADDRESS=
CANNED_TOKEN_ADDRESS=
CLAIM_VAULT_ADDRESS=
CLAIM_SIGNER_PRIVATE_KEY=
CLAIM_INTENT_EXPIRY_SECONDS=3600
# For launch/mainnet later:
# XLAYER_CHAIN_ID=196
