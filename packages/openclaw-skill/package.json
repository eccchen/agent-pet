{
  "name": "@agent-game/openclaw-skill",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent Pet OpenClaw skill — control your on-chain pet agent in natural language.",
  "keywords": [
    "agent-pet",
    "openclaw",
    "skill",
    "blockchain",
    "game",
    "okx"
  ],
  "repository": {
    "type": "git",
